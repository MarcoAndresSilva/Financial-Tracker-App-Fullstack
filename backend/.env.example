# backend/.env.example
DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase?schema=public"
JWT_SECRET="change-this-super-secret-key"
# URL del frontend: origen permitido por CORS y base del link de "restablecer contraseña"
FRONTEND_URL="http://localhost:4200"
# Email transaccional (Brevo). Sin estas dos variables el email no se envía:
# el link de restablecimiento se escribe en el log del backend.
BREVO_API_KEY=""
MAIL_FROM=""
MAIL_FROM_NAME="FinTrack"
