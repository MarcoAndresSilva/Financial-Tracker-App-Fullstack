generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
//          ENUMERATIONS
// ========================================

enum WalletType {
  PERSONAL
  SHARED
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ========================================
//          APPLICATION MODELS
// ========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Momento del último cambio de contraseña. JwtStrategy rechaza cualquier token
  // emitido antes de esta fecha, así cambiar o restablecer la contraseña cierra
  // las sesiones abiertas en otros dispositivos aunque el JWT sea stateless.
  passwordChangedAt DateTime?

  memberships WalletMembership[]
  transactions Transaction[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens EmailChangeToken[]
}

// Token de un solo uso para "¿Olvidaste tu contraseña?". Se guarda solo el hash
// SHA-256 del token: el valor real viaja únicamente en el link del email, así que
// una filtración de la BD no permite restablecer la contraseña de nadie.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Cambio de email pendiente de confirmar (Paso 68). El email nuevo no se aplica
// hasta que se abre el link enviado a ESE email: así un error de tipeo no deja
// la cuenta con un correo al que nadie llega. Igual que PasswordResetToken, se
// guarda solo el hash del token.
model EmailChangeToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  newEmail  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id        String     @id @default(uuid())
  name      String
  type      WalletType @default(PERSONAL)
  // Lo que ya tenías ahorrado antes de empezar a registrar en la app. Sirve de
  // punto de partida para el "saldo acumulado" del panel de Ahorro (Paso 53);
  // no es un ingreso ni afecta los totales de ningún mes.
  saldoInicial Float    @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  memberships  WalletMembership[]
  categories   Category[]
  transactions Transaction[]
  savingsGoals SavingsGoal[]
  debts        Debt[]
}

model WalletMembership {
  id        String         @id @default(uuid())
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([userId, walletId]) // Un usuario solo puede pertenecer una vez a una cartera
}

model Category {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletId      String
  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]

  @@unique([walletId, name]) // El nombre de la categoría debe ser único por cartera
}

model Subcategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  // Si es la subcategoría de una deuda (Paso 77), sus gastos son pagos.
  debt         Debt?

  @@unique([categoryId, name]) // El nombre de la subcategoría debe ser único por categoría
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Float
  type        TransactionType
  // Solo la fecha (sin hora): una transacción ocurre "un día", no "un instante".
  // Guardarla como timestamp provocaba corrimientos de día al renderizar en un
  // huso horario distinto al del servidor (ver Paso 51).
  date        DateTime        @db.Date
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// Un compromiso pagado en cuotas: una compra en cuotas de una casa comercial o un
// crédito/préstamo con pagos periódicos. El progreso NO se guarda como un campo que
// se edita a mano — se calcula sumando las Transaction vinculadas (`payments`), para
// que nunca se desincronice de lo que realmente se registró como gasto (Paso 68).
// Tipo de deuda (Paso 77):
//   INSTALLMENTS → en cuotas (hipotecario, consumo, tarjetas, casas comerciales):
//                  el avance se mide en cantidad de cuotas.
//   FREE_AMOUNT  → monto libre (préstamo familiar): un total del que se
//                  descuenta cada pago, sin cuotas ni fechas fijas.
enum DebtKind {
  INSTALLMENTS
  FREE_AMOUNT
}

// Unidad en que está expresada la cuota. En UF, el monto en pesos cambia cada
// mes y se estima con el valor de la UF del día.
enum AmountUnit {
  CLP
  UF
}

model Debt {
  id   String   @id @default(uuid())
  name String
  kind DebtKind

  // --- Solo INSTALLMENTS ---
  totalInstallments Int?
  // Valor de cada cuota en su unidad (ej. 8.44 UF o 45000 pesos).
  installmentValue  Float?
  unit              AmountUnit?
  // Cuotas pagadas ANTES de registrar la deuda en la app ("voy en la 41").
  initialPaidInstallments Int @default(0)
  // Vencimiento de la próxima cuota al registrarla (la N° initialPaid + 1).
  // Es el ancla fija desde la que se calculan todas las demás fechas.
  nextDueDateAtStart DateTime? @db.Date

  // --- Solo FREE_AMOUNT ---
  totalAmount       Float?
  // Plata pagada ANTES de registrar la deuda en la app.
  initialPaidAmount Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // La subcategoría (dentro de "Deudas") donde se registran sus pagos: todo
  // GASTO en ella creado después de la deuda es una cuota pagada. Restrict:
  // no se puede borrar la subcategoría mientras la deuda exista; borrar la
  // deuda, en cambio, deja la subcategoría y sus pagos como historial.
  subcategoryId String      @unique
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  @@unique([walletId, name]) // El nombre de la deuda debe ser único por cartera
}

model SavingsGoal {
  id            String   @id @default(uuid())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, name]) // El nombre de la meta debe ser único por cartera
}